[Unit]
Description=Flagship website and API
After=network.target postgresql.service flagship-browser.service
Wants=postgresql.service flagship-directus.service flagship-browser.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=hazem
Group=hazem
WorkingDirectory=/opt/flagship
ExecStart=/opt/flagship/target/release/Flagship
Environment=FLAGSHIP_LOCAL_DEV=false
Environment=BIND_ADDRESS=127.0.0.1:3000
Environment=FLAGSHIP_WEB_DIR=/opt/flagship/website/dist
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=mixed
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
