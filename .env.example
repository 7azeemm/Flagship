# Local PostgreSQL connection. URL-encode special characters in the password.
DATABASE_URL=postgres://flagship:replace-me-db-password@localhost:5432/flagship
FLAGSHIP_DB_PASSWORD=replace-me-db-password
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=replace-me-postgres-password

# Local app origin; local launcher overrides this for dev mode.
APP_PUBLIC_URL=https://example.invalid
BIND_ADDRESS=127.0.0.1:3000
FLAGSHIP_WEB_DIR=website/dist
RUST_LOG=info,playwright_rs=off
ENABLE_SCANNING=false

# Required by backend configuration, even when you do not plan to send email.
# Supply a real SMTP account only in a private local .env when testing delivery.
SMTP_HOST=smtp.example.invalid
SMTP_PORT=587
SMTP_USERNAME=replace-me-smtp-user
SMTP_PASSWORD=replace-me-smtp-password
SMTP_FROM="FlagShip <noreply@example.invalid>"

# Optional Google sign-in. Set all three together or leave them empty.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=

# Optional proxy trust list (comma-separated IP addresses).
TRUSTED_PROXY_IPS=

# Optional Directus staff interface credentials (required for Directus setup).
DIRECTUS_PORT=8055
DIRECTUS_PUBLIC_URL=http://localhost:8055
DIRECTUS_SECRET=replace-me-directus-secret
DIRECTUS_DB_PASSWORD=replace-me-directus-db-password
DIRECTUS_ADMIN_EMAIL=admin@example.invalid
DIRECTUS_ADMIN_PASSWORD=replace-me-directus-admin-password
DIRECTUS_ADMIN_TOKEN=replace-me-directus-admin-token

# Optional production Discord integration. Use a separate development bot for dev.
DISCORD_TOKEN=
DISCORD_GUILD_ID=
DISCORD_ADDED_PRODUCT_CHANNEL_ID=
DISCORD_EDITED_PRODUCT_CHANNEL_ID=
DISCORD_REMOVED_PRODUCT_CHANNEL_ID=
DISCORD_SCAN_CHANNEL_ID=
DISCORD_ALERT_CHANNEL_ID=
ENABLE_DISCORD=
DISCORD_DEV_TOKEN=
DISCORD_DEV_GUILD_ID=
DISCORD_DEV_ADDED_PRODUCT_CHANNEL_ID=
DISCORD_DEV_EDITED_PRODUCT_CHANNEL_ID=
DISCORD_DEV_REMOVED_PRODUCT_CHANNEL_ID=
DISCORD_DEV_SCAN_CHANNEL_ID=
DISCORD_DEV_ALERT_CHANNEL_ID=
ENABLE_DISCORD_DEV=

# Optional local tooling overrides.
LOCAL_APP_PUBLIC_URL=http://127.0.0.1:5173
POSTGRES_BIN_DIR=
POSTGRES_SERVICE=
API_PROXY_TARGET=http://127.0.0.1:3000
FLAGSHIP_APP_ORIGIN=http://127.0.0.1:5173
